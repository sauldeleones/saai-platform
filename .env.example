# Proveedor de IA: "ollama" (local, gratis) o "claude" (API de pago)
AI_PROVIDER=ollama

# Modelo a usar según el proveedor
AI_MODEL=llama3
# AI_MODEL=claude-sonnet-4-20250514

# URL del servidor Ollama (solo si AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# API Key de Anthropic (solo si AI_PROVIDER=claude)
ANTHROPIC_API_KEY=tu_key_aqui

# Clave secreta para la aplicación
SECRET_KEY=cambia_esto_por_una_clave_segura
